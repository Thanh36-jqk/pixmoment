# Vercel Blob (Storage tab in your Vercel project → Create Database → Blob)
# — used for the photos themselves, store must be created with public access.
BLOB_READ_WRITE_TOKEN=

# A SECOND Vercel Blob store, created with private access, for album/owner
# JSON (contains password hashes / is keyed by a supposed-to-be-secret owner
# id). Vercel Blob stores are all-public or all-private — a public store
# rejects private writes outright — so this can't share BLOB_READ_WRITE_TOKEN
# above. Create via `vercel blob create-store <name> --access private`, then
# connect with a prefix so it doesn't collide with the existing token, e.g.
# `vercel integration-resource connect <name> --prefix PRIVATE_`.
PRIVATE_READ_WRITE_TOKEN=

# Upstash Redis — used to rate limit the public upload/album endpoints,
# which have no user accounts to authenticate against. Free tier at
# https://upstash.com. If unset, rate limiting is skipped (the app still
# runs, just without abuse protection — a warning is logged).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Shared secret for the scheduled cleanup job (/api/cron/cleanup, see
# vercel.json). Vercel Cron sends it as `Authorization: Bearer <secret>`;
# the route fails closed (returns 401) if this is unset, so set it in
# production or expired albums/photos will never be swept. Generate any
# random string, e.g. `openssl rand -hex 32`.
CRON_SECRET=
