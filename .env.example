# Vercel Blob (Storage tab in your Vercel project → Create Database → Blob)
BLOB_READ_WRITE_TOKEN=

# Upstash Redis — used to rate limit the public upload/album endpoints,
# which have no user accounts to authenticate against. Free tier at
# https://upstash.com. If unset, rate limiting is skipped (the app still
# runs, just without abuse protection — a warning is logged).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
